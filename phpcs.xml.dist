<?xml version="1.0"?>
<ruleset name="sf-legacy">
    <description>PHP coding standard for sf-legacy.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>public</file>

    <exclude-pattern>config/reference.php</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
