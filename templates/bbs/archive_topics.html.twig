{% extends 'base.html.twig' %}

{% block content %}
    <h2>トピック一覧 {{ date }}</h2>
    <span class="text-[13px]">◆＝スレッド表示　木＝ツリー表示 - 件数 - 最終更新日時 - 内容</span>
    <hr>
    <pre>{% for topic in topics %}<a href="{{ path('app_thread', {threadId: topic.thread_id}) }}" aria-label="スレッド表示" title="スレッド表示">◆</a> <a href="{{ path('app_thread_tree', {threadId: topic.thread_id}) }}" aria-label="ツリー表示" title="ツリー表示">木</a> {{ '%02d'|format(topic.reply_count) }} [{{ topic.updated_at|bbs_datetime }}] {{ topic.digest }}
{% endfor %}</pre>
    <hr>
    <a href="{{ path('app_archive') }}">過去ログ検索へ</a>
{% endblock %}
