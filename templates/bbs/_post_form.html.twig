<form id="post-form" class="flex w-full flex-col items-start gap-2" action="{{ path('app_submit') }}" method="post">
    {% if return_to|default(null) %}
        <input type="hidden" name="return_to" value="{{ return_to }}">
    {% endif %}
    {% if reply %}
        <input type="hidden" name="reply_to" value="{{ reply.post_id }}">
    {% endif %}
    <div class="post-fields flex flex-col gap-0">
        <div class="flex items-center gap-2">
            <label class="w-14" for="author">投稿者</label>
            <input id="author" name="author" type="text">
        </div>
        <div class="flex items-center gap-2">
            <label class="w-14" for="email">メール</label>
            <input class="w-72" id="email" name="email" type="email">
        </div>
        <div class="post-title-row flex items-center gap-2">
            <label class="w-14" for="title">題名</label>
            <input class="w-72" id="title" name="title" type="text" value="{{ reply ? '＞' ~ reply.author : '' }}">
            <span class="post-title-actions">
                <button type="submit" name="post" class="btn">投稿／リロード</button>
                <button type="reset" class="btn">消す</button>
            </span>
        </div>
    </div>
    <div class="post-content-field">
        <label for="content">内容</label>
        <span class="post-field-help">（適当に改行を入れてください。タグは使えません。）</span>
        <textarea class="post-content" id="content" name="content" rows="5" cols="70">{{ reply_message }}</textarea>
    </div>
    <div class="post-settings">
        {% if not reply %}
            <label>
                表示件数
                <input name="display_count" type="number" min="1" max="1000" value="{{ display_count|default(40) }}">
            </label>
        {% endif %}
        <label><input name="auto_link" type="checkbox" value="1"{% if auto_link_enabled|default(true) %} checked{% endif %}> URL自動リンク</label>
        {% if not reply %}
            <a class="settings-button" href="{{ path('app_personal_settings') }}" role="button">個人用環境設定</a>
        {% endif %}
    </div>
    {% if page_view_count is defined and visitor_count is defined %}
        <div class="small bbs-stats">
            <span class="page-view-counter">{{ page_view_started_at }}（{{ page_view_started_at|time_ago }}）から {{ page_view_count }}</span>
            <span>　 現在の参加者 : {{ visitor_count }}人 ({{ visitor_limit }}秒以内)</span>
            <span>　 最大記事件数 : {{ central_post_limit }}件</span>
        </div>
        <div class="archive-heading">
            <hr>
            <div class="lower-links">
                <a href="#">広報室</a>
                | <a href="{{ path('app_archive') }}">過去ログ</a>
                {% for link in additional_links|default([]) %}
                    | <a class="additional-link" href="{{ link.url }}">{{ link.label }}</a>
                {% endfor %}
            </div>
            <hr>
            <div class="post-help">■ : フォロー投稿(返信)　★ : 投稿者検索　◆ : スレッド表示　木 : ツリー表示　× : 自分の投稿を消す（直前の投稿のみ）</div>
            <hr>
        </div>
    {% endif %}
    {% if not reply %}
        <span class="post-form-actions">
            <button type="submit" name="post" class="btn">投稿／リロード</button>
            <button type="submit" class="btn" form="unread-form">未読</button>
            <button type="button" data-scroll-target="page-bottom" aria-label="一番下へ">▼</button>
        </span>
    {% endif %}
</form>
{% if not reply %}
    <form id="unread-form" action="{{ return_to|default(path('app_hello')) }}" method="get" hidden>
        <input type="hidden" name="readnew" value="1">
        <input type="hidden" name="p" value="{{ latest_post_id|default(0) }}">
        <input type="hidden" name="display_count" value="{{ display_count|default(40) }}">
    </form>
{% endif %}
