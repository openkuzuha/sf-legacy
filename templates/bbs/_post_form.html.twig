<form id="post-form" class="flex w-full flex-col items-start gap-2" action="{{ path('app_submit') }}" method="post">
    {% if reply %}
        <input type="hidden" name="reply_to" value="{{ reply.post_id }}">
    {% endif %}
    <div class="post-fields flex flex-col gap-0">
        <div class="flex items-center gap-2">
            <label class="w-14" for="author">投稿者</label>
            <input id="author" name="author" type="text">
        </div>
        <div class="flex items-center gap-2">
            <label class="w-14" for="email">メール</label>
            <input class="w-72" id="email" name="email" type="email">
        </div>
        <div class="post-title-row flex items-center gap-2">
            <label class="w-14" for="title">題名</label>
            <input class="w-72" id="title" name="title" type="text" value="{{ reply ? '＞' ~ reply.author : '' }}">
            <span class="post-title-actions">
                <button type="submit" name="post" class="btn">投稿／リロード</button>
                <button type="reset" class="btn">消す</button>
            </span>
        </div>
    </div>
    <label for="content">内容</label>
    <textarea class="post-content" id="content" name="content" rows="5" cols="70">{{ reply_message }}</textarea>
    <div class="flex items-center gap-3">
        <label>
            表示件数
            <input class="w-20" name="display_count" type="number" min="1" max="1000" value="{{ display_count|default(40) }}">
        </label>
        <label><input name="auto_link" type="checkbox" value="1"{% if auto_link_enabled|default(true) %} checked{% endif %}> URL自動リンク</label>
    </div>
    {% if page_view_count is defined and visitor_count is defined %}
        <div class="small">
            <span class="page-view-counter">{{ page_view_started_at }} から {{ page_view_count }}</span>
            <span>　 現在の参加者 : {{ visitor_count }}人 ({{ visitor_limit }}秒以内)</span>
            <span>　 最大記事件数 : {{ central_post_limit }}件</span>
        </div>
        <div class="archive-heading">
            <hr>
            <div><a href="{{ path('app_archive') }}">過去ログ</a></div>
            <hr>
            <div>■ : フォロー投稿(返信)</div>
            <hr>
        </div>
    {% endif %}
    <span class="post-form-actions">
        <button type="submit" name="post" class="btn">投稿／リロード</button>
        <button type="button" data-scroll-target="page-bottom" aria-label="一番下へ">▼</button>
    </span>
</form>
