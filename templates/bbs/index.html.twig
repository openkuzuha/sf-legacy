{% extends 'base.html.twig' %}

{% block content %}
            {{ include('bbs/_post_form.html.twig', {
                reply: null,
                reply_message: '',
                no_unread_message: unread_requested and posts is empty,
            }) }}
            {% if posts %}
                <hr>
            {% endif %}
            {% for post in posts %}
                <div class="m" id="m{{ post.post_id }}">
                    <span class="nw">
                        <span class="ms">{{ post.title }}</span>&nbsp;&nbsp;
                        <span class="mu">投稿者：<span class="mun">{{ include('bbs/_author_name.html.twig', {post: post}) }}</span></span>&nbsp;&nbsp;
                        <span class="md">
                            投稿日：<time datetime="{{ post.posted_at }}">{{ post.posted_at|bbs_datetime }}</time><a
                                name="a{{ post.post_id }}"
                                id="a{{ post.post_id }}"
                            >&nbsp;</a>
                        </span>
                        <span class="nb">
                        &nbsp;<a
                            href="{{ path('app_reply', {postId: post.post_id}) }}"
                            aria-label="Reply"
                            title="Reply"
                        >■</a>
                        {% if post.author|replace({　: ''})|trim %}
                        &nbsp;<a
                            href="{{ path('app_author_search', {name: post.author|trim}) }}"
                            aria-label="投稿者検索"
                            title="投稿者検索"
                        >★</a>
                        {% endif %}
                        &nbsp;<a
                            href="{{ path('app_thread', {threadId: post.thread_id}) }}"
                            aria-label="スレッド表示"
                            title="スレッド表示"
                        >◆</a>
                        &nbsp;<a
                            href="{{ path('app_thread_tree', {threadId: post.thread_id, p: latest_post_id}) }}"
                            aria-label="ツリー表示"
                            title="ツリー表示"
                        >木</a>
                        {{ include('bbs/_undo_button.html.twig', {post: post}) }}
                        </span>
                    </span>
                    <blockquote>
                        {% set reference = post.reference is defined ? post.reference : null %}
                        {% set message = reference ? post.message|trim(null, 'right') : post.message %}
                        <pre>{{ message|message_html(post.auto_link) }}{% if reference %}{{ '\n\n' }}<a href="{{ path('app_reply', {postId: reference.post_id}) }}">参考：{{ reference.posted_at|bbs_datetime }}</a>{% endif %}</pre>
                    </blockquote>
                </div>
                <hr>
                <!--  -->
            {% endfor %}
            {% if posts %}
                <p class="msgmore">
                    {% if unread_requested %}
                        以上は、画面表示後に投稿された未読記事です。
                    {% else %}
                        以上は、現在登録されている新着順{{ range_start }}番目から{{ range_end }}番目までの記事です。
                    {% endif %}
                </p>
            {% endif %}
            {% if posts %}
                <nav class="page-actions" aria-label="ページ操作">
                    {% if next_before %}
                        <form action="{{ path('app_hello') }}" method="get">
                            <input type="hidden" name="before" value="{{ next_before }}">
                            <input type="hidden" name="display_count" value="{{ display_count }}">
                            <button type="submit">次のページ</button>
                        </form>
                    {% endif %}
                    <form action="{{ path('app_hello') }}" method="get">
                        <input type="hidden" name="display_count" value="{{ display_count }}">
                        <button type="submit">リロード</button>
                    </form>
                    <button type="button" data-scroll-target="page-top" aria-label="一番上へ">▲</button>
                </nav>
            {% endif %}
{% endblock %}
