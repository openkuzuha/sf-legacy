{% extends 'base.html.twig' %}

{% block content %}
            {{ include('bbs/_post_form.html.twig', {reply: null, reply_message: ''}) }}
            <div class="small">現在の参加者 : {{ visitor_count }}人 ({{ visitor_limit }}秒以内)</div>
            {% if posts %}
                <hr>
            {% endif %}
            {% for post in posts %}
                <div class="m" id="m{{ post.post_id }}">
                    <span class="nw">
                        <span class="ms">{{ post.title }}</span>&nbsp;&nbsp;
                        <span class="mu">投稿者：<span class="mun">{{ post.author }}</span></span>&nbsp;&nbsp;
                        <span class="md">
                            投稿日：<time datetime="{{ post.posted_at }}">{{ post.posted_at|bbs_datetime }}（{{ post.posted_at|time_ago }}）</time><a
                                name="a{{ post.post_id }}"
                                id="a{{ post.post_id }}"
                            >&nbsp;</a>
                        </span>
                        &nbsp;<a
                            href="{{ path('app_reply', {postId: post.post_id}) }}"
                            aria-label="Reply"
                            title="Reply"
                        >■</a>
                        &nbsp;<a
                            href="{{ path('app_thread', {threadId: post.thread_id}) }}"
                            aria-label="スレッド表示"
                            title="スレッド表示"
                        >◆</a>
                        &nbsp;<a
                            href="{{ path('app_thread_tree', {threadId: post.thread_id}) }}"
                            aria-label="ツリー表示"
                            title="ツリー表示"
                        >木</a>
                    </span>
                    <blockquote>
                        {% set reference = post.reference is defined ? post.reference : null %}
                        {% set message = reference ? post.message|trim(null, 'right') : post.message %}
                        <pre>{% if post.auto_link %}{{ message|auto_link }}{% else %}{{ message }}{% endif %}{% if reference %}{{ '\n\n' }}<a href="{{ path('app_thread_tree', {threadId: post.thread_id}) }}#m{{ reference.post_id }}">参考：{{ reference.posted_at|bbs_datetime }}</a>{% endif %}</pre>
                    </blockquote>
                </div>
                <hr>
                <!--  -->
            {% endfor %}
            {% if posts %}
                <p class="msgmore">
                    以上は、現在登録されている新着順{{ range_start }}番目から{{ range_end }}番目までの記事です。
                </p>
            {% endif %}
            {% if posts %}
                <nav class="page-actions" aria-label="ページ操作">
                    {% if next_before %}
                        <form action="{{ path('app_hello') }}" method="get">
                            <input type="hidden" name="before" value="{{ next_before }}">
                            <button type="submit">次のページ</button>
                        </form>
                    {% endif %}
                    <form action="{{ path('app_hello') }}" method="get">
                        <button type="submit">リロード</button>
                    </form>
                    <button type="button" data-scroll-target="page-top" aria-label="一番上へ">▲</button>
                </nav>
            {% endif %}
{% endblock %}

{% block footer %}
        <footer class="text-[13px] text-right">
            <hr>
            <a href="https://github.com/openkuzuha/sf-legacy" target="_blank" rel="noopener noreferrer">
                Open Kuzuha / sf-legacy
            </a>
            <br>
            <a class="credit-logo" href="{{ path('app_hello') }}" aria-label="Open Kuzuha トップへ">
                <img src="/logo.svg" alt="" width="32" height="32">
            </a>
        </footer>
{% endblock %}
