{% extends 'base.html.twig' %}

{% block content %}
            <form class="flex flex-col items-start gap-2" action="{{ path('app_submit') }}" method="post">
                <div class="post-fields flex flex-col gap-0">
                    <div class="flex items-center gap-2">
                        <label class="w-14" for="author">投稿者</label>
                        <input id="author" name="author" type="text">
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="w-14" for="email">メール</label>
                        <input class="w-72" id="email" name="email" type="email">
                    </div>
                    <div class="post-title-row flex items-center gap-2">
                        <label class="w-14" for="title">題名</label>
                        <input class="w-72" id="title" name="title" type="text">
                        <span class="post-title-actions">
                            <button type="submit" name="post" class="btn">投稿／リロード</button>
                            <button type="reset" class="btn">消す</button>
                        </span>
                    </div>
                </div>
                <label for="content">内容</label>
                <textarea class="post-content" id="content" name="content" rows="5" cols="70"></textarea>
                {#
                <label for="url">URL （リンクを入れたい場合はここに記入します。）</label>
                <input class="w-[36rem]" id="url" name="url" type="text" placeholder="https://">
                #}
                <button type="submit" name="post" class="btn">投稿／リロード</button>
            </form>
            {% if posts %}
                <hr>
            {% endif %}
            {% for post in posts %}
                <div class="m" id="m{{ post.post_id }}">
                    <span class="nw">
                        <span class="ms">{{ post.title }}</span>&nbsp;&nbsp;
                        <span class="mu">投稿者：<span class="mun">{{ post.author }}</span></span>&nbsp;&nbsp;
                        <span class="md">
                            投稿日：<time datetime="{{ post.posted_at }}">{{ post.posted_at|bbs_datetime }}（{{ post.posted_at|time_ago }}）</time><a
                                name="a{{ post.post_id }}"
                                id="a{{ post.post_id }}"
                            >&nbsp;</a>
                        </span>
                        &nbsp;<a
                            href="{{ path('app_thread_tree', {threadId: post.thread_id}) }}"
                            aria-label="ツリー表示"
                            title="ツリー表示"
                        >木</a>
                    </span>
                    <blockquote>
                        <pre>{% if post.auto_link %}{{ post.message|auto_link }}{% else %}{{ post.message }}{% endif %}</pre>
                    </blockquote>
                </div>
                {% if not loop.last %}
                    <hr>
                {% endif %}
                <!--  -->
            {% endfor %}
{% endblock %}

{% block footer %}
        <footer class="text-[13px] text-right">
            <hr>
            <a href="https://github.com/openkuzuha/sf-legacy" target="_blank" rel="noopener noreferrer">
                Open Kuzuha / sf-legacy
            </a>
        </footer>
{% endblock %}
