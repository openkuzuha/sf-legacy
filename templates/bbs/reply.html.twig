{% extends 'base.html.twig' %}

{% block content %}
            <hr>
            <div class="m" id="m{{ reply.post_id }}">
                <span class="nw">
                    <span class="ms">{{ reply.title }}</span>&nbsp;&nbsp;
                    <span class="mu">投稿者：<span class="mun">{{ reply.author }}</span></span>&nbsp;&nbsp;
                    <span class="md">投稿日：<time datetime="{{ reply.posted_at }}">{{ reply.posted_at|bbs_datetime }}</time></span>
                    &nbsp;<a href="{{ path('app_reply', {postId: reply.post_id}) }}" aria-label="Reply" title="Reply">■</a>
                    {% if reply.author|replace({　: ''})|trim %}&nbsp;<a href="{{ path('app_author_search', {name: reply.author|trim}) }}" aria-label="投稿者検索" title="投稿者検索">★</a>{% endif %}
                    &nbsp;<a href="{{ path('app_thread', {threadId: reply.thread_id}) }}" aria-label="スレッド表示" title="スレッド表示">◆</a>
                    &nbsp;<a href="{{ path('app_thread_tree', {threadId: reply.thread_id}) }}" aria-label="ツリー表示" title="ツリー表示">木</a>
                </span>
                <blockquote>
                    <pre>{{ reply.message|message_html(reply.auto_link) }}</pre>
                </blockquote>
            </div>
            <hr>
            <p>フォロー記事投稿(返信)　<a href="{{ path('app_hello') }}">戻る</a></p>
            {{ include('bbs/_post_form.html.twig', {reply: reply, reply_message: reply_message, return_to: return_to}) }}
{% endblock %}
