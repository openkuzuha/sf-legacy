{% extends 'base.html.twig' %}

{% import 'bbs/_tree.html.twig' as tree %}

{% block page_header %}{% endblock %}
{% block footer_separator %}{% endblock %}
{% block footer_links %}<a href="#page-top" aria-label="一番上へ">▲</a>{% endblock %}

{% block content %}
            <hr>
            <p class="tree-updated">
                <span class="nb"><a href="{{ path('app_thread', {threadId: thread_id}) }}" aria-label="スレッド表示" title="スレッド表示">◆</a></span>
                [更新日：<time datetime="{{ updated_at }}">{{ updated_at|bbs_datetime }}</time>]
            </p>
            {{ tree.branches(children, 'root', path('app_thread_tree', {threadId: thread_id}), unread_after_post_id, undo_enabled) }}
            <hr>
            <a href="{{ path('app_hello') }}">戻る</a>
{% endblock %}
