{% extends 'base.html.twig' %}

{% import 'bbs/_tree.html.twig' as tree %}

{% block content %}
            <nav><a href="{{ path('app_hello') }}">掲示板へ戻る</a></nav>
            <hr>
            <p class="tree-updated">
                <span class="nb"><a href="{{ path('app_thread', {threadId: thread_id}) }}" aria-label="スレッド表示" title="スレッド表示">◆</a></span>
                更新日：<time datetime="{{ updated_at }}">{{ updated_at|bbs_datetime }}</time>
            </p>
            {{ tree.branches(children, 'root', path('app_thread_tree', {threadId: thread_id}), unread_after_post_id) }}
{% endblock %}
