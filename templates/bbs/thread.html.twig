{% extends 'base.html.twig' %}

{% block content %}
            <hr>
            {% for post in posts %}
                <div class="m" id="m{{ post.post_id }}">
                    <span class="nw">
                        <span class="ms">{{ post.title }}</span>&nbsp;&nbsp;
                        <span class="mu">投稿者：<span class="mun">{{ post.author }}</span></span>&nbsp;&nbsp;
                        <span class="md">
                            投稿日：<time datetime="{{ post.posted_at }}">{{ post.posted_at|bbs_datetime }}（{{ post.posted_at|time_ago }}）</time>
                        </span>
                        &nbsp;<a href="{{ path('app_reply', {postId: post.post_id}) }}" aria-label="Reply" title="Reply">■</a>
                        {% if post.author|replace({　: ''})|trim %}&nbsp;<a href="{{ path('app_author_search', {name: post.author|trim}) }}" aria-label="投稿者検索" title="投稿者検索">★</a>{% endif %}
                        &nbsp;<a href="{{ path('app_thread', {threadId: post.thread_id}) }}" aria-label="スレッド表示" title="スレッド表示">◆</a>
                        &nbsp;<a href="{{ path('app_thread_tree', {threadId: post.thread_id}) }}" aria-label="ツリー表示" title="ツリー表示">木</a>
                        {{ include('bbs/_undo_button.html.twig', {post: post}) }}
                    </span>
                    <blockquote>
                        {% set message = post.reference ? post.message|trim(null, 'right') : post.message %}
                    <pre>{{ message|message_html(post.auto_link) }}{% if post.reference %}{{ '\n\n' }}<a href="{{ path('app_reply', {postId: post.reference.post_id}) }}">参考：{{ post.reference.posted_at|bbs_datetime }}</a>{% endif %}</pre>
                    </blockquote>
                </div>
                <hr>
                <!--  -->
            {% endfor %}
            <p>{{ posts|length }}件見つかりました。　<a href="{{ path('app_hello') }}">戻る</a></p>
{% endblock %}
