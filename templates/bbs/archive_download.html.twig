{% extends 'base.html.twig' %}

{% block content %}
    <h2>過去ログ {{ date }}</h2>
    <hr>
    {% for post in posts %}
        <div class="m" id="m{{ post.post_id }}">
            <span class="nw">
                <span class="ms">{{ post.title }}</span>&nbsp;&nbsp;
                <span class="mu">投稿者：<span class="mun">{{ include('bbs/_author_name.html.twig', {post: post}) }}</span></span>&nbsp;&nbsp;
                <span class="md">投稿日：<time datetime="{{ post.posted_at }}">{{ post.posted_at|bbs_datetime }}</time></span>
            </span>
            <blockquote><pre>{{ post.message|message_html(post.auto_link) }}</pre></blockquote>
        </div>
        <hr>
    {% endfor %}
    <p>{{ posts|length }}件</p>
{% endblock %}
