{% extends 'base.html.twig' %}

{% block content %}
    <style>
        .search-highlight { background: #ff0; color: #000; }
    </style>
    <h2>過去ログ一覧</h2>
    <p>直近{{ archive_public_days }}日分を公開しています。</p>
    <form action="{{ path('app_archive') }}" method="get">
        <ul style="list-style: none;">
            {% for archive in archives %}
                <li>
                    <label>
                        <input type="checkbox" name="archives[]" value="{{ archive.date }}"{% if archive.date in selected_archives %} checked{% endif %}>
                    </label>
                    <a href="{{ path('app_archive', {archives: [archive.date], keyword: ''}) }}">{{ archive.date }}</a>
                    {{ archive.formatted_size }} {{ archive.post_count }}件
                    <a href="{{ path('app_archive_topics', {date: archive.date}) }}">トピック一覧</a>
                    <a href="{{ path('app_archive_download', {date: archive.date}) }}">ダウンロード</a>
                </li>
            {% endfor %}
        </ul>
        {% if archives %}
            <button type="button" data-toggle-archive-selection>全選択／解除</button>
        {% endif %}
        <hr>
        <div>
            <label for="archive-keyword">キーワード指定</label><br>
            <input id="archive-keyword" name="keyword" type="text" size="40" value="{{ keyword }}" style="max-width: 100%; box-sizing: border-box;">
            <button type="submit">検索</button>
        </div>
    </form>
    {% if search_performed %}
        <hr>
        <p>
            対象：{% if selected_archives %}{{ selected_archives|join('、') }}{% else %}（未選択）{% endif %}
            {% if keyword %}／キーワード：{{ keyword }}{% endif %}
        </p>
        {% for post in posts %}
            <div class="m" id="m{{ post.post_id }}">
                <span class="nw">
                    <span class="ms">{{ post.title|search_highlight(keyword) }}</span>&nbsp;&nbsp;
                    <span class="mu">投稿者：<span class="mun">
                        {%- if post.author_spoofed ?? false -%}
                            {{- post.author|replace({'（騙り）': ''})|search_highlight(keyword) -}}<span class="muh">（騙り）</span>
                        {%- else -%}
                            {{- post.author|search_highlight(keyword) -}}
                        {%- endif -%}
                    </span></span>&nbsp;&nbsp;
                    <span class="md">投稿日：<time datetime="{{ post.posted_at }}">{{ post.posted_at|bbs_datetime }}</time></span>
                </span>
                <blockquote><pre>{{ post.message|message_html(post.auto_link, keyword) }}</pre></blockquote>
            </div>
            <hr>
        {% endfor %}
        <p>{{ posts|length }}件見つかりました。</p>
    {% endif %}
    <script>
        document.querySelector('[data-toggle-archive-selection]')?.addEventListener('click', (event) => {
            const checkboxes = event.currentTarget.form.querySelectorAll('input[name="archives[]"]');
            const selectAll = Array.from(checkboxes).some((checkbox) => !checkbox.checked);
            checkboxes.forEach((checkbox) => checkbox.checked = selectAll);
        });
    </script>
{% endblock %}
