<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="/favicon.ico" sizes="any">
        <title>{{ app_title }}</title>
        {{ vite_entry_link_tags('app') }}
        {{ vite_entry_script_tags('app') }}
    </head>
    <body id="page-top">
        <main>
            <h1><a href="{{ path('app_hello') }}">{{ app_title }}</a></h1>
            {% block content %}{% endblock %}
        </main>
        <footer id="page-bottom" class="text-[13px] text-right">
            <hr>
            <div class="request-duration">実行時間 : {{ request_duration() }}秒</div>
            <a href="https://github.com/openkuzuha/sf-legacy" target="_blank" rel="noopener noreferrer">
                Open Kuzuha / sf-legacy
            </a>
            <br>
            <a class="credit-logo" href="{{ path('app_hello') }}" aria-label="トップへ">
                <img src="/logo.svg" alt="" width="32" height="32">
            </a>
        </footer>
    </body>
</html>
