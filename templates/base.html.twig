<!DOCTYPE html>
<html lang="ja" style="--bbs-background: {{ bbs_colors.background }}; --bbs-text: {{ bbs_colors.text }}; --bbs-link: {{ bbs_colors.link }}; --bbs-visited-link: {{ bbs_colors.visited_link }}; --bbs-active-link: {{ bbs_colors.active_link }}; --bbs-hover-link: {{ bbs_colors.hover_link }}; --bbs-subject: {{ bbs_colors.subject }}; --bbs-quote: {{ bbs_colors.quote }};">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="/favicon.ico" sizes="any">
        <title>{{ app_title }}</title>
        {{ vite_entry_link_tags('app') }}
        {{ vite_entry_script_tags('app') }}
    </head>
    <body id="page-top">
        <main>
            <header class="page-header">
                <h1 class="page-title"><a href="{{ path('app_hello') }}">{{ app_title }}</a></h1>
                <a class="header-link" href="#">広報室</a>
                <a class="header-link" href="#">連絡先</a>
                <a class="header-link" href="{{ path('app_archive') }}">過去ログ</a>
                {% if app.current_route in ['app_tree', 'app_thread_tree'] %}
                    <a class="header-link" href="{{ path('app_hello') }}">標準画面</a>
                {% else %}
                    <a class="header-link" href="{{ path('app_tree', latest_post_id is defined ? {p: latest_post_id} : {}) }}">ツリー表示</a>
                {% endif %}
            </header>
            {% block content %}{% endblock %}
        </main>
        <footer id="page-bottom" class="text-[13px] text-right">
            <hr>
            <div class="request-duration">実行時間 : {{ request_duration() }}秒</div>
            <a href="https://github.com/openkuzuha/sf-legacy" target="_blank" rel="noopener noreferrer">
                Open Kuzuha / sf-legacy
            </a>
            <br>
            <a class="credit-logo" href="{{ path('app_hello') }}" aria-label="トップへ">
                <img src="/logo.svg" alt="" width="32" height="32">
            </a>
        </footer>
    </body>
</html>
