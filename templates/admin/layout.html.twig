{% extends 'base.html.twig' %}

{% block page_header %}
    <header class="page-header admin-header">
        <h1 class="page-title"><a href="{{ path('app_admin_settings') }}">管理画面</a></h1>
        <a class="header-link" href="{{ path('app_hello') }}">掲示板へ戻る</a>
    </header>
{% endblock %}

{% block content %}
    <section class="admin-panel !max-w-3xl">
        <nav class="mb-6 grid grid-cols-2 gap-1 rounded-xl border border-white/20 bg-black/15 p-1 shadow-lg shadow-black/10 sm:inline-flex sm:min-w-md" aria-label="管理メニュー">
            <a
                class="flex items-center justify-center gap-2 rounded-lg px-4 py-3 text-sm font-semibold no-underline transition duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white {% if app.current_route == 'app_admin_settings' %}!bg-white !text-teal-950 shadow-md{% else %}!text-white hover:bg-white/10 hover:!text-white{% endif %}"
                href="{{ path('app_admin_settings') }}"
                {% if app.current_route == 'app_admin_settings' %}aria-current="page"{% endif %}
            >
                <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75A3.75 3.75 0 1 0 12 8.25a3.75 3.75 0 0 0 0 7.5Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12a7.5 7.5 0 0 0-.1-1.2l2-1.55-2-3.46-2.48 1A7.6 7.6 0 0 0 14.85 5.6L14.5 3h-5l-.35 2.6a7.6 7.6 0 0 0-2.07 1.2l-2.48-1-2 3.45 2 1.55a7.6 7.6 0 0 0 0 2.4l-2 1.55 2 3.46 2.48-1a7.6 7.6 0 0 0 2.07 1.2L9.5 21h5l.35-2.6a7.6 7.6 0 0 0 2.07-1.2l2.48 1 2-3.45-2-1.55c.07-.4.1-.8.1-1.2Z" />
                </svg>
                設定管理
            </a>
            <a
                class="flex items-center justify-center gap-2 rounded-lg px-4 py-3 text-sm font-semibold no-underline transition duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white {% if app.current_route == 'app_admin_posts' %}!bg-white !text-teal-950 shadow-md{% else %}!text-white hover:bg-white/10 hover:!text-white{% endif %}"
                href="{{ path('app_admin_posts') }}"
                {% if app.current_route == 'app_admin_posts' %}aria-current="page"{% endif %}
            >
                <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z" />
                    <path stroke-linecap="round" d="M8 9h8M8 12.5h8M8 16h5" />
                </svg>
                投稿記事管理
            </a>
        </nav>
        {% for message in app.flashes('admin_success') %}
            <p class="admin-success" role="status">{{ message }}</p>
        {% endfor %}
        {% for message in app.flashes('admin_error') %}
            <p class="admin-error" role="alert">{{ message }}</p>
        {% endfor %}
        {% block admin_content %}{% endblock %}
        <form class="admin-logout-form" action="{{ path('app_admin_logout') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_logout') }}">
            <button type="submit">ログアウト</button>
        </form>
    </section>
{% endblock %}
