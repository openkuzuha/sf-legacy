<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ app_title }}</title>
        {{ vite_entry_link_tags('app') }}
        {{ vite_entry_script_tags('app') }}
    </head>
    <body>
        <main>
            <h1>{{ app_title }}</h1>
            <form class="flex flex-col items-start gap-2" action="{{ path('app_submit') }}" method="post">
                <label for="content">内容</label>
                <textarea id="content" name="content" rows="5" cols="70"></textarea>
                <button type="submit" name="post" class="btn">投稿／リロード</button>
            </form>
        </main>
        <footer class="text-[13px] text-right">
            <hr>
            <a href="https://github.com/openkuzuha/sf-legacy" target="_blank" rel="noopener noreferrer">
                Open Kuzuha / sf-legacy
            </a>
        </footer>
    </body>
</html>
