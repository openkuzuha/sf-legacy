{
    "name": "app/sf-legacy",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "pentatrion/vite-bundle": "^8.2",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/var-dumper": "^7.4 || ^8.0",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
