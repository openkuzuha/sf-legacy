{
    "name": "app/sf-legacy",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "nesbot/carbon": "^3.0",
        "pentatrion/vite-bundle": "^8.2",
        "predis/predis": "^2.3",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/var-dumper": "^7.4 || ^8.0",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*",
        "vincentlanglet/twig-cs-fixer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@composer validate --no-check-publish",
            "@php vendor/bin/pest --colors=always",
            "@php vendor/bin/phpstan analyse --no-progress",
            "@php vendor/bin/phpcs",
            "@php bin/console lint:twig templates --show-deprecations",
            "@php vendor/bin/twig-cs-fixer lint templates --no-cache"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
